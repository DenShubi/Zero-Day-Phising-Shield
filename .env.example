# ============================================================================
# VisiKartika Shield - Environment Variables (.env.example)
# Salin file ini menjadi `.env` di dalam folder `backend-engine/`
# ============================================================================

# --- 1. Supabase Configuration (Minta dari Dashboard Supabase Person B / Denin) ---
# Lokasi: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxx-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=scan-evidence

# --- 2. WhatsApp Gateway: OpenWA (Baileys) — gateway aktif ---
# Jalankan openwa-gateway/ (port 2785), scan QR di dashboard, lalu daftarkan webhook
# ke http://localhost:8000/webhook/openwa dengan event "message.received".
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=owa_k1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENWA_SESSION_ID=your-openwa-session-uuid
# Secret webhook (HMAC X-OpenWA-Signature). WAJIB diisi bila webhook diakses dari luar localhost
# (ngrok / VPS / Railway). Tanpa secret, hanya request dari localhost yang diterima.
OPENWA_WEBHOOK_SECRET=
# Alternatif untuk caller remote yang tidak bisa HMAC: tambahkan ?token=<nilai> pada URL webhook
OPENWA_WEBHOOK_TOKEN=
# true = bot juga membalas di grup WhatsApp
OPENWA_ALLOW_GROUPS=false
# false = jangan kirim gambar bukti ber-bounding box
OPENWA_SEND_EVIDENCE=true

# --- 2b. (Legacy) Fonnte API — tidak lagi dipakai, tidak mendukung kirim/terima gambar di paket gratis ---
FONNTE_TOKEN=
FONNTE_WEBHOOK_TOKEN=

# --- 4. Keamanan API ---
# Origin dashboard yang boleh memanggil API dari browser (pisahkan koma)
CORS_ORIGINS=http://localhost:3000
# Header X-Admin-Key untuk endpoint admin (seed-portals) bila dipanggil bukan dari localhost
ADMIN_API_KEY=
# true HANYA di laptop developer: izinkan scan ke alamat lokal/privat selain /mock-targets/
ALLOW_PRIVATE_SCAN_TARGETS=false
# true untuk menyimpan payload webhook Fonnte terakhir (nomor HP dimasking) ke storage/
WA_DEBUG_PAYLOAD=false

# --- 3. Public Backend Base URL (Fallback URL untuk gambar bukti lokal) ---
PUBLIC_BACKEND_URL=http://localhost:8000

