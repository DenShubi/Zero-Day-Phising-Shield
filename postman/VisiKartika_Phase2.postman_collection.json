                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"CRITICAL\", () => pm.expect(j.verdict).to.eql(\"CRITICAL_PHISHING\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Scan kemhan_auth_phish (Identity-Domain Mismatch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scan-url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "scan-url"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{baseUrl}}/mock-targets/kemhan_auth_phish.html\",\n  \"scan_id\": \"postman_kemhan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"CRITICAL\", () => pm.expect(j.verdict).to.eql(\"CRITICAL_PHISHING\"));",
                  "pm.test(\"rule override tercatat\", () => pm.expect(j.applied_rules.join(\" \")).to.include(\"IDENTITY_DOMAIN_MISMATCH\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Scan poster Quishing (gambar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scan-image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "scan-image"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_url\": \"mock_targets/assets/poster_quishing_bintara.png\",\n  \"scan_id\": \"postman_poster\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"QR terbaca\", () => pm.expect(j.decoded_qr_codes.length).to.eql(1));",
                  "pm.test(\"CRITICAL\", () => pm.expect(j.verdict).to.eql(\"CRITICAL_PHISHING\"));",
                  "pm.test(\"< 5 detik\", () => pm.expect(j.execution_time_sec).to.be.below(5));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Simulasi webhook OpenWA (tanpa kirim WA)",
      "item": [
        {
          "name": "Pesan teks 'portal'",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhook/openwa?sync=true&dry_run=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "openwa"
              ],
              "query": [
                {
                  "key": "sync",
                  "value": "true"
                },
                {
                  "key": "dry_run",
                  "value": "true"
                }
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"message.received\",\n  \"sessionId\": \"{{openwaSessionId}}\",\n  \"data\": {\n    \"id\": \"POSTMAN1\",\n    \"from\": \"6281234567890@c.us\",\n    \"chatId\": \"6281234567890@c.us\",\n    \"fromMe\": false,\n    \"isGroup\": false,\n    \"kind\": \"individual\",\n    \"type\": \"chat\",\n    \"contact\": {\n      \"pushName\": \"Serda Postman\"\n    },\n    \"body\": \"portal\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"COMMAND\", () => pm.expect(j.triage).to.eql(\"COMMAND\"));"
                ]
